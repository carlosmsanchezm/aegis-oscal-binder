# Git SHA shown in the footer (first 7 characters).
# When unset, the server uses VERCEL_GIT_COMMIT_SHA if that is set, otherwise "local".
AEGIS_COMMIT=

# Writable directory for sessions, uploads, and export artifacts.
# When set, pipeline history, session snapshots, and saved remediation drafts use this directory.
# When unset, a local run uses ./.data if that path is writable, otherwise the OS temp directory.
# On Vercel, leave this unset. The connected private Blob store is the durable store.
AEGIS_DATA_DIR=

# Demo-only encrypted snapshot key: 32 random bytes encoded as 64 hex characters.
# Required for /demo/sa1 in production. Keep the real value in the host secret store.
AEGIS_DEMO_COOKIE_KEY=

# Encrypted, session-bound draft fallback when durable storage is unset.
# Required in production for this fallback: 32 random bytes as 64 hex characters.
# Set in the preview host secret store; never commit the real value.
AEGIS_REMEDIATION_COOKIE_KEY=

# Shared HMAC secret for POST /api/pipeline/events (header X-Aegis-Signature: sha256=<hex>).
# Keep the real value in the host secret store. Do not commit it.
AEGIS_PIPELINE_WEBHOOK_SECRET=

# Read-only GitHub App for scanning a repository without a local checkout.
# Do not commit the private key or webhook secret. A PEM may use literal \n escapes.
# The app requests read-only permissions (actions, contents, metadata, pull requests, checks).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Private Blob credential for inbound releases, session package snapshots, and saved remediation drafts.
# Set by connecting a private Vercel Blob store to the project. Do not commit it.
BLOB_READ_WRITE_TOKEN=
