        "tag:List*",
        "wafv2:BatchGet*",
        "wafv2:Describe*",
        "wafv2:Get*",
        "wafv2:List*",
        "iam:GenerateCredentialReport",
        "iam:GetCredentialReport",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyCredentialMinting",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateAccessKey",
        "iam:UpdateLoginProfile",
        "sts:AssumeRole",
        "sts:AssumeRoleWithSAML",
        "sts:AssumeRoleWithWebIdentity",
        "sts:GetFederationToken",
        "sts:GetSessionToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDataReads",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject*",
        "secretsmanager:GetSecretValue",
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "ssm:GetParameter*",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GovCloudRegionsOnly",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "sso:*",
        "identitystore:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-gov-west-1",
            "us-gov-east-1"
          ]
        }
      }
    },
    {
      "Sid": "AllowCredentialReportAndCaller",
      "Effect": "Allow",
      "Action": [
        "iam:GenerateCredentialReport",
        "iam:GetCredentialReport",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
